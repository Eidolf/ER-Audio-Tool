{
  "manifest_version": 3,
  "name": "er-audio-tool Companion",
  "version": "1.0.0",
  "description": "Secure companion extension for er-audio-tool to capture user-selected tab audio with full user consent.",
  "author": "Eidolf",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "er-audio-tool Tab Capture",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
